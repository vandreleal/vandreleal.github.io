# Not served by GitHub Pages. Header-only directives; the per-page CSP <meta> owns
# script-src and style-src.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
